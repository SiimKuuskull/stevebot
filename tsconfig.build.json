{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "incremental": true,
        "noEmit": false,
        "noEmitOnError": true,
        "outDir": "dist",
        "rootDir": "src",
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
