{
    "name": "stevebot",
    "description": "",
    "version": "1.0.0",
    "license": "ISC",
    "main": "dist/src/app.js",
    "scripts": {
        "start": "node dist/src/app.js",
        "start-dev": "node --watch dist/src/app.js",
        "start-web": "node dist/src/web.js",
        "start-web-dev": "nodemon dist/src/web.js",
        "test-integration": "mocha test/integration/*",
        "test-unit": "mocha test/unit/*",
        "register-slash-commands": "node dist/src/scripts/register-slash-commands.js",
        "lint": "eslint",
        "lint-fix": "eslint --fix",
        "make-migration": "knex migrate:make",
        "build": "rimraf dist && npm run -s build-ts",
        "watch": "rimraf dist && npm run -s watch-ts",
        "build-ts": "tsc",
        "watch-ts": "tsc -w"
    },
    "dependencies": {
        "bluebird": "^3.7.2",
        "chalk": "^4.1.2",
        "cors": "^2.8.5",
        "discord.js": "^14.11.0",
        "dotenv": "^16.1.3",
        "express": "^4.22.3",
        "knex": "^2.4.2",
        "knex-stringcase": "^1.4.6",
        "lodash": "^4.17.21",
        "luxon": "^3.3.0",
        "node-fetch": "^2.7.0",
        "pg": "^8.12.0",
        "pg-promise": "^11.9.1",
        "source-map-support": "^0.5.21",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/chai": "^4.3.4",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.17",
        "@types/lodash": "^4.14.184",
        "@types/luxon": "^3.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "^20.14.7",
        "@types/sinon": "^22.0.0",
        "chai": "^4.3.7",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "mocha": "^12.0.3",
        "nock": "^13.3.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.3.3",
        "rimraf": "^5.0.0",
        "sinon": "^22.1.0",
        "ts-node": "^10.9.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.4.0"
    },
    "mocha": {
        "require": [
            "ts-node/register/transpile-only"
        ],
        "timeout": 20000,
        "extension": [
            "ts"
        ],
        "recursive": true,
        "watch-extensions": [
            "test.ts"
        ]
    }
}
