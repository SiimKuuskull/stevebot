{
    "name": "stevebot",
    "description": "",
    "version": "1.0.0",
    "license": "ISC",
    "main": "dist/app.js",
    "type": "module",
    "scripts": {
        "start": "node --enable-source-maps dist/app.js",
        "start-dev": "node --enable-source-maps --watch dist/app.js",
        "start-web": "node --enable-source-maps dist/web.js",
        "start-web-dev": "node --enable-source-maps --watch dist/web.js",
        "test-integration": "mocha test/integration/*",
        "test-unit": "mocha test/unit/*",
        "register-slash-commands": "node --enable-source-maps dist/scripts/register-slash-commands.js",
        "lint": "eslint",
        "lint-fix": "eslint --fix",
        "make-migration": "NODE_OPTIONS='--import tsx' knex migrate:make",
        "build": "rimraf dist && tsc",
        "watch": "rimraf dist && tsc -w"
    },
    "dependencies": {
        "bluebird": "^3.7.2",
        "chalk": "^4.1.2",
        "cors": "^2.8.5",
        "discord.js": "^14.11.0",
        "dotenv": "^18.0.7",
        "express": "^5.3.0",
        "knex": "^3.3.0",
        "knex-stringcase": "^1.6.0",
        "lodash": "^4.18.1",
        "luxon": "^3.7.2",
        "pg": "^8.12.0",
        "pg-promise": "^12.7.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bluebird": "^3.5.42",
        "@types/chai": "^5.2.3",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.6",
        "@types/lodash": "^4.17.26",
        "@types/luxon": "^3.7.6",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.5",
        "@types/sinon": "^22.0.0",
        "chai": "^6.3.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "mocha": "^12.0.3",
        "nock": "^15.0.1",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "sinon": "^22.1.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    },
    "mocha": {
        "node-option": [
            "import=tsx"
        ],
        "timeout": 20000,
        "extension": [
            "ts"
        ],
        "recursive": true,
        "watch-extensions": [
            "test.ts"
        ]
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
